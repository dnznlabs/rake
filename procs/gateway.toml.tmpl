ServerPort = "$GATEWAY_PORT"
RunAsHttp = true
IsBehindHttpsProxy = false
HomePage = "/"
CORS = "*"
defaultChain = $GATEWAY_CHAIN_ID
requestLimit = 50
[pageCache]
enabled = false
[nsDefaultChains]
[name2chain]
"anvil" = $GATEWAY_CHAIN_ID
[chainConfigs]
    [chainConfigs.$GATEWAY_CHAIN_ID]
    "ChainID" = $GATEWAY_CHAIN_ID
    "RPC" = "$GATEWAY_RPC"
