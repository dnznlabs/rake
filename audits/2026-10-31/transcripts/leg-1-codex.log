     4	import {Ownable} from "solady/auth/Ownable.sol";
     5	import {SSTORE2} from "solady/utils/SSTORE2.sol";
     6	import {Base64} from "solady/utils/Base64.sol";
     7	
     8	/// @title App
     9	/// @notice The dapp and its embeddable widget, hosted by this contract.
    10	///         ERC-8244: `html()` returns the whole document.
    11	///         ERC-5219 / ERC-6944: `request()` serves "/" with a text/html header so web3:// gateways
    12	///         render it at the root, and `request(["widget.js"])` the widget as application/javascript.
    13	/// @dev Two resources, two pointer lists: `chunks` for the dapp and `widgetChunks` for the widget.
    14	///      Each document lives in SSTORE2 chunks, concatenated at read time. If `gzipped`, `html()` wraps
    15	///      the base64 payload in a bootstrap that inflates it client-side with DecompressionStream. The
    16	///      widget is served raw and never wrapped: a `<script src="widget.js">` fetched through a gateway
    17	///      must be plain JavaScript, and the bootstrap is an HTML document a script tag cannot run.
    18	///      `lock()` freezes both lists; it requires the dapp and does not require a widget.
    19	contract App is Ownable {
    20	    struct KeyValue {
    21	        string key;
    22	        string value;
    23	    }
    24	
    25	    address[] public chunks;
    26	    address[] public widgetChunks;
    27	    bool public gzipped;
    28	    bool public locked;
    29	    string public version;
    30	
    31	    event ChunksSet(uint256 count, bool gzipped);
    32	    event WidgetChunksSet(uint256 count);
    33	    event VersionSet(string version);
    34	    event AppLocked();
    35	
    36	    error Locked();
    37	    /// @dev A pointer holding no code. `SSTORE2.read` on one expands memory past any block gas limit,
    38	    ///      so `html()` and `request()` would run out of gas for every caller.
    39	    error CodelessChunk(address ptr);
    40	    /// @dev No pointers at all: `html()` would return an empty document.
    41	    error EmptyDocument();
    42	
    43	    constructor(address owner_, string memory version_) {
    44	        _initializeOwner(owner_);
    45	        version = version_;
    46	    }
    47	
    48	    /// @dev Every byte of the bootstrap is load-bearing and `test_gzipBootstrap` pins all of it.
    49	    ///      It swaps the document in with `DOMParser`, not `document.open()`, which orphans an
    50	    ///      extension wallet's content script. `DOMParser` marks the scripts it builds non-executable,
    51	    ///      so each is re-created; `replaceWith` runs an inline script synchronously on insertion,
    52	    ///      which preserves document order for inline, attribute-free scripts and nothing else.
    53	    function html() public view returns (string memory) {
    54	        bytes memory doc = _raw(chunks);
    55	        if (!gzipped) return string(doc);
    56	        return string.concat(
    57	            '<!DOCTYPE html><html><head><meta charset="utf-8"><title>app</title></head><body><script>',
    58	            '(async()=>{const b=atob("',
    59	            Base64.encode(doc),
    60	            '");',
    61	            "const u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);",
    62	            "const t=await new Response(new Blob([u]).stream().pipeThrough(new DecompressionStream('gzip'))).text();",
    63	            "const d=new DOMParser().parseFromString(t,'text/html');",
    64	            "document.replaceChild(document.importNode(d.documentElement,true),document.documentElement);",
    65	            "for(const s of[...document.querySelectorAll('script')]){const n=document.createElement('script');",
    66	            "for(const a of s.attributes)n.setAttribute(a.name,a.value);",
    67	            "n.textContent=s.textContent;s.replaceWith(n);}})();",
    68	            "</script></body></html>"
    69	        );
    70	    }
    71	
    72	    /// @notice The widget, as stored: the raw concatenation of `widgetChunks`, never wrapped.
    73	    function widget() public view returns (string memory) {
    74	        return string(_raw(widgetChunks));
    75	    }
    76	
    77	    function resolveMode() external pure returns (bytes32) {
