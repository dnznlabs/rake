   172	        // argument-less custom error: no reason worth bubbling, so name the failure instead
   173	        // (decision 24). Anything longer carries its own reason and keeps it.
   174	        if (!ok) {
   175	            if (data.length <= 32) revert ReleaseFailed(token);
   176	            _bubble(data);
   177	        }
   178	        emit Released(token, account, amount);
   179	    }
