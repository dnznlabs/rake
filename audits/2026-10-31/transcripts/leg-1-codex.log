   139	    /// @notice Split everything not already escrowed between the table, in table order.
   140	    /// @param token The ERC-20 to split, or `address(0)` for ETH.
   141	    function distribute(address token) external nonReentrant {
   142	        uint256 amount = _balance(token) - reserved[token];
   143	        if (amount == 0) revert NothingToDo();
   144	
   145	        uint256 n = _table.length;
   146	        uint256 paid;
   147	        for (uint256 i; i < n; ++i) {
   148	            Beneficiary storage b = _table[i];
   149	            // The last row takes the remainder, so the shares always sum to `amount`.
   150	            uint256 share = i + 1 == n ? amount - paid : (uint256(b.bps) * amount) / BPS_TOTAL;
   151	            paid += share;
   152	            address account = b.account;
   153	            (bool ok,) = _push(token, account, share, false);
   154	            if (!ok) {
   155	                escrowed[token][account] += share;
   156	                reserved[token] += share;
   157	                emit Escrowed(token, account, share);
   158	            }
   159	        }
   160	        emit Distributed(token, amount);
   161	    }
   162	
   163	    /// @notice Retry the escrowed amount for one account. Reverts if the retry fails, leaving the escrow.
   164	    function release(address token, address account) external nonReentrant {
   165	        uint256 amount = escrowed[token][account];
   166	        if (amount == 0) revert NothingToDo();
   167	
   168	        escrowed[token][account] = 0;
   169	        reserved[token] -= amount;
   170	        (bool ok, bytes memory data) = _push(token, account, amount, true);
