   299	    /// @dev Drops every queued action, newest first, emitting `Cancelled` for each so a log reader's
   300	    /// pending list empties the way it would have by hand. Runs on a handover and on a renounce:
   301	    /// what the previous owner queued was queued under an authority that no longer exists.
   302	    function _clearQueue() private {
   303	        uint256 n = _pending.length;
   304	        while (n > 0) {
   305	            bytes32 hash = _pending[--n].hash;
