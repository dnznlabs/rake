   333	    /// @dev A token with no code returns nothing here, which does not decode — so it fails.
   334	    function _balance(address token) private view returns (uint256) {
   335	        if (token == address(0)) return address(this).balance;
   336	
   337	        (bool ok, bytes memory data) = token.staticcall(abi.encodeWithSelector(BALANCE_OF, address(this)));
   338	        if (!ok) _bubble(data);
   339	        return abi.decode(data, (uint256));
   340	    }
   341	
   342	    /// @dev ETH is capped so one hostile recipient cannot burn the whole distribution; an ERC-20 push
   343	    /// is bounded by the token. A no-return token (mainnet USDT) counts as success; anything else must
   344	    /// answer with a word equal to one, decoded as a `uint256` so hostile return data cannot revert here.
   345	    ///
   346	    /// `keepData` buys the ETH branch's return data. `distribute` passes false and calls with a
   347	    /// zero-length output area, so a recipient reverting with megabytes costs it one `RETURNDATASIZE`
   348	    /// it never reads instead of the memory to hold them — unbounded copying inside the loop broke the
   349	    /// half-block property decision 27 rests on at about eleven hostile rows. `release` passes true,
   350	    /// because decision 24 bubbles a reason longer than a word and cannot name one it did not copy.
   351	    /// The ERC-20 branch ignores the flag: it needs the return word below, and the token is the one
   352	    /// `distribute(token)` was called with, so a hostile token's return data costs only the caller who
   353	    /// named it.
   354	    function _push(address token, address to, uint256 amount, bool keepData)
   355	        private
   356	        returns (bool ok, bytes memory data)
   357	    {
   358	        if (token == address(0)) {
   359	            if (keepData) {
   360	                (ok, data) = to.call{value: amount, gas: PUSH_GAS}("");
   361	            } else {
   362	                uint256 gasCap = PUSH_GAS;
   363	                assembly ("memory-safe") {
   364	                    ok := call(gasCap, to, amount, 0, 0, 0, 0)
   365	                }
   366	            }
   367	            return (ok, data);
   368	        }
   369	        (ok, data) = token.call(abi.encodeWithSelector(TRANSFER, to, amount));
   370	        ok = ok && (data.length == 0 || (data.length >= 32 && abi.decode(data, (uint256)) == 1));
   371	    }
   372	
   373	    function _bubble(bytes memory data) private pure {
   374	        assembly ("memory-safe") {
   375	            revert(add(data, 0x20), mload(data))
   376	        }
   377	    }
   378	}
