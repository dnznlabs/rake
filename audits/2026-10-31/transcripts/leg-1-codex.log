   380	/// @notice Deploys `Distribution` clones to an address that depends on this factory and a salt alone.
   381	/// @dev No `receive` and no `fallback`, so ETH sent to the factory itself reverts; the implementation
   382	/// rejects it too. Clones are PUSH0 minimal proxies placed with CREATE2, so the same factory reaches
   383	/// the same clone address on every chain.
   384	contract DistributionFactory {
   385	    event Created(address indexed distribution, address indexed owner);
   386	
   387	    error DeploymentFailed();
   388	    error SaltDoesNotStartWith();
   389	
   390	    /// @dev Deployed by the factory, so `Distribution.factory` is this contract on every clone.
   391	    address public immutable implementation = address(new Distribution{salt: bytes32(0)}());
   392	
   393	    /// @notice Deploy and initialise a clone at `predict(salt)`.
   394	    /// @param salt Its top 20 bytes must equal `msg.sender`. `msg.value` rides the CREATE2, so a
   395	    /// deposit lands in the clone without a `Received` log.
   396	    /// @dev Three properties the dapp has to know about this address:
   397	    /// 1. It depends on this factory and `salt` only — not on the owner, delay, description or table.
   398	    ///    So the sender fixes the address; the owner does not enter it. One EOA calls `create` with
   399	    ///    the same salt on every chain and passes the vault as `owner_`, and the clone is owned by
   400	    ///    that vault from its first block at one address, with no ownership transfer ever needed.
   401	    ///    Each chain is a separate contract: transferring ownership on one changes neither the salt
   402	    ///    nor any other chain, so the deploying key never needs to own anything.
   403	    /// 2. A second `create` with a used salt burns the whole gas limit before `DeploymentFailed`: a
   404	    ///    CREATE2 collision consumes every unit forwarded to it. Read `predict(salt)` with
   405	    ///    `eth_getCode` first and refuse a non-empty answer.
   406	    /// 3. Same-address-everywhere is this factory's address, not a clone's claim on its own. The
   407	    ///    factory is nonce-addressed where it is deployed; a byte-identical deploy through a
   408	    ///    deterministic deployer is a later milestone's one-way door.
   409	    function create(
   410	        address owner_,
   411	        uint32 delay_,
   412	        string calldata description_,
   413	        Distribution.Beneficiary[] calldata table_,
   414	        bytes32 salt
   415	    ) external payable returns (address distribution) {
   416	        address impl = implementation;
   417	        uint256 prefix = uint256(salt) >> 96;
   418	        if (prefix != uint256(uint160(msg.sender))) revert SaltDoesNotStartWith();
   419	
   420	        // The PUSH0 minimal-proxy init code, byte for byte as solady's `LibClone.initCode_PUSH0`
   421	        // writes it. The two `mstore`s at 0x24 overlap the free memory pointer and restore it.
   422	        assembly ("memory-safe") {
   423	            mstore(0x24, 0x5af43d5f5f3e6029573d5ffd5b3d5ff3)
   424	            mstore(0x14, impl)
   425	            mstore(0x00, 0x602d5f8160095f39f35f5f365f5f37365f73)
   426	            distribution := create2(callvalue(), 0x0e, 0x36, salt)
   427	            if iszero(distribution) {
   428	                mstore(0x00, 0x30116425) // DeploymentFailed()
   429	                revert(0x1c, 0x04)
   430	            }
   431	            mstore(0x24, 0)
   432	        }
   433	        Distribution(payable(distribution)).init(owner_, delay_, description_, table_);
   434	        emit Created(distribution, owner_);
   435	    }
   436	
   437	    /// @notice The address `create(..., salt)` would reach.
   438	    /// @dev No prefix check: the dapp predicts before it knows who will send.
   439	    function predict(bytes32 salt) external view returns (address) {
   440	        address impl = implementation;
   441	        bytes32 initCodeHash;
   442	        assembly ("memory-safe") {
   443	            mstore(0x24, 0x5af43d5f5f3e6029573d5ffd5b3d5ff3)
   444	            mstore(0x14, impl)
   445	            mstore(0x00, 0x602d5f8160095f39f35f5f365f5f37365f73)
   446	            initCodeHash := keccak256(0x0e, 0x36)
   447	            mstore(0x24, 0)
   448	        }
   449	        return address(uint160(uint256(keccak256(abi.encodePacked(hex"ff", address(this), salt, initCodeHash)))));
   450	    }
   451	}
