   313	    /// @dev Swap-and-pop, so `_pending` stays iterable and the surviving order is stable otherwise.
   314	    function _remove(bytes32 hash) private {
   315	        uint256 i = _pendingIndex[hash];
   316	        if (i == 0) return;
   317	
   318	        uint256 last = _pending.length;
   319	        if (i != last) {
   320	            Pending storage moved = _pending[last - 1];
   321	            _pending[i - 1] = moved;
   322	            _pendingIndex[moved.hash] = i;
   323	        }
   324	        _pending.pop();
   325	        delete _pendingIndex[hash];
   326	    }
