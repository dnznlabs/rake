   485	    /// @notice The address `create(..., salt)` would reach.
   486	    /// @dev No prefix check: the dapp predicts before it knows who will send.
   487	    function predict(bytes32 salt) external view returns (address) {
   488	        address impl = implementation;
   489	        bytes32 initCodeHash;
   490	        assembly ("memory-safe") {
   491	            mstore(0x24, 0x5af43d5f5f3e6029573d5ffd5b3d5ff3)
   492	            mstore(0x14, impl)
   493	            mstore(0x00, 0x602d5f8160095f39f35f5f365f5f37365f73)
   494	            initCodeHash := keccak256(0x0e, 0x36)
   495	            mstore(0x24, 0)
   496	        }
   497	        return address(uint160(uint256(keccak256(abi.encodePacked(hex"ff", address(this), salt, initCodeHash)))));
   498	    }
   499	}
