   475	            if iszero(distribution) {
   476	                mstore(0x00, 0x30116425) // DeploymentFailed()
   477	                revert(0x1c, 0x04)
   478	            }
   479	            mstore(0x24, 0)
   480	        }
   481	        Distribution(payable(distribution)).init(owner_, delay_, description_, table_);
   482	        emit Created(distribution, owner_);
   483	    }
