.planning
.envrc.local
.claude/settings.local.json
.devbox/

# Project ignores below.

# fragment: forge-anvil
cache/
out/
# Dev-chain broadcast logs are throwaway; real-network ones are the deployment record.
!/broadcast
/broadcast/*/31337/
# A second anvil on 31338 is how the dev chains' same-address property is checked.
/broadcast/*/31338/
/broadcast/**/dry-run/
.env
.env.*
!.env.example

# fragment: dapp
# Built bundle: network-specific once addresses are substituted.
app/dist/
# What the chain returns, written by `make chain-doc`. Not under forge's `out/`, which a build empties.
app/chain/
node_modules/

# fragment: forge-audit
# Audit scratch. The skill writes .solidity-auditor/runs/<stamp>/ into the repo on every
# scan whatever flags it gets, and scripts/audit.sh relocates those bytes under
# audits/<date>/ — without this, every audit would land in git twice. audits/.skills/ is
# the pinned clone of someone else's MIT-licensed prose: pinned, deliberately not vendored.
.solidity-auditor/
audits/.skills/
# The skill's per-scan bundle, `mktemp -d ./.audit-XXXXXX`. A scan that dies leaves it behind by
# design, and unignored it would make the next audit's provenance record itself as dirty.
.audit-*/
